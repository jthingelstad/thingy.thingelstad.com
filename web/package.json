{
  "name": "thingy-web",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Thingy web app — thin client of the Librarian API.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vite build",
    "contract:generate": "node scripts/generate-contract-client.mjs",
    "contract:generate:check": "node scripts/generate-contract-client.mjs --check",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check",
    "serve": "vite --host 0.0.0.0",
    "clean": "rm -rf _site",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{ts,json}\"",
    "lint": "oxlint . --deny-warnings",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "knip": "knip --no-config-hints --include files,dependencies,unlisted",
    "qa:real": "node scripts/qa-real-api.mjs",
    "smoke": "node scripts/smoke-browser.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='src/generated/**' --test-coverage-exclude='tests/**' --test-coverage-lines=60 --test-coverage-branches=58 --test-coverage-functions=46 tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run contract:generate:check && npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run knip && npm run test:coverage && npm run test:components",
    "test:components": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "happy-dom": "^20.13.2",
    "knip": "^6.27.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "fast-uri": "^3.1.6"
  }
}
